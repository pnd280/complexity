{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    },
    "target": "ESNext",
    "types": ["chrome"]
  },
  "exclude": ["node_modules", "release/cli/**/*"],
  "extends": "@complexity/typescript-config/base.json",
  "include": [
    "e2e/**/*",
    "src/**/*",
    "tests/**/*",
    "vite-plugins/**/*",
    "vite.config.ts"
  ]
}
