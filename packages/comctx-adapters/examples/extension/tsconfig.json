{
  "extends": "@complexity/typescript-config/base.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "incremental": false,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["./src/**/*", "./vite.config.ts", "./eslint.config.js"]
}
